rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is a designated administrator
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == '9990.999900aaaaaazzzz@gmail.com' || 
         request.auth.token.email == '099853ssf@gmail.com');
    }
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User profile rules
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Orders rules
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    
    // Products rules (Dynamic collection)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Wishlists rules
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
